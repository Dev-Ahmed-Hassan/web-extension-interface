{
  "manifest_version": 3,
  "name": "ScamLess - Job Scam Detector",
  "version": "2.0.0",
  "description": "Instant Agentic OSINT job scam verification & authenticity score powered by ScamLess.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "ScamLess Job Scam Detector"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "windows": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Open ScamLess Job Scam Detector"
    }
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://phishing-detector-self-five.vercel.app/*",
    "https://naukrinigran.vercel.app/*"
  ]
}
